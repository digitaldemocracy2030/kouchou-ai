{
  "name": "kouchou-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "pnpm --filter @kouchou-ai/e2e-tests test",
    "test:e2e:ui": "pnpm --filter @kouchou-ai/e2e-tests test:ui",
    "test:e2e:report": "pnpm --filter @kouchou-ai/e2e-tests report",
    "build:packages": "pnpm --filter './packages/*' build",
    "clean": "pnpm -r exec rm -rf node_modules dist .next"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.64.1",
    "lefthook": "^1.11.8"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.8"
  },
  "pnpm": {
    "overrides": {
      "@tootallnate/once": "2.0.1",
      "diff": "4.0.4",
      "follow-redirects": "1.16.2",
      "lodash": "4.18.1",
      "path-to-regexp": "8.4.2",
      "picomatch": "2.3.2",
      "postcss": "8.5.23",
      "qs": "6.16.1",
      "ws": "8.21.0",
      "yaml": "1.10.3",
      "zod": "4.6.6",
      "@babel/core@<7.29.6": "7.29.6",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "browserslist@<4.28.7": "4.28.7",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "glob@>=9.0.0 <14.0.2": "14.0.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "nanoid@<3.3.18": "3.3.18",
      "ip-address@<10.7.4": "10.7.5",
      "probe-image-size@<7.4.0": "7.4.0",
      "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
