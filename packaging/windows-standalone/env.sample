# kouchou-ai standalone configuration. Copy/rename to ".env" (build.ps1 does this).
# Loaded by apps/api src.config at startup.

ENVIRONMENT=production
STORAGE_TYPE=local

# API keys protecting the local admin/public endpoints (any non-empty value).
ADMIN_API_KEY=local-admin
PUBLIC_API_KEY=local-public

# --- LLM provider ---------------------------------------------------------
# For a fully local setup, run LM Studio (OpenAI-compatible server, default
# localhost:1234) and select provider="local" with local_llm_address in the
# admin UI. The OpenAI key below is then unused but must be present.
OPENAI_API_KEY=not-needed-for-local-llm

# Use a cloud provider instead by setting a real key:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
