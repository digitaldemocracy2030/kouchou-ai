{
  "name": "@kouchou-ai/public-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/with-renamed-files.mjs next build",
    "prebuild:static": "pnpm run copy-image",
    "build:static": "NEXT_PUBLIC_OUTPUT_MODE=export node scripts/with-renamed-files.mjs next build",
    "prebuild:shell": "pnpm run copy-image",
    "build:shell": "NEXT_PUBLIC_OUTPUT_MODE=export NEXT_PUBLIC_STATIC_SHELL=1 node scripts/with-renamed-files.mjs next build --webpack",
    "copy-image": "node scripts/copy-image.mjs",
    "rename-file": "node scripts/rename-file.mjs rename",
    "restore-file": "node scripts/rename-file.mjs restore",
    "start": "next start",
    "start:static": "http-server out -p 3000",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "jest && node --test scripts/copy-image.test.mjs",
    "typegen:chakra": "npx @chakra-ui/cli typegen ./components/theme/system.ts"
  },
  "dependencies": {
    "@kouchou-ai/report-schema": "workspace:*",
    "@chakra-ui/react": "^3.5.1",
    "@emotion/react": "^11.14.0",
    "@next/third-parties": "^16.3.8",
    "lucide-react": "^0.474.0",
    "next": "16.4.2",
    "next-themes": "^0.4.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "react-plotly.js": "^4.1.0",
    "react-window": "^1.8.11",
    "plotly.js": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@chakra-ui/cli": "^3.21.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5"
  }
}
